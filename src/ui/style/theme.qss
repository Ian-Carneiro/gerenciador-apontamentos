/*
 * Apontador de Horas — theme.qss
 * Tema: Mariana (Sublime HQ / Dmitri Voronianski)
 *
 * Paleta:
 *   bg-base      #2f3840   fundo da janela        blue3
 *   bg-alt       #242b31   header / linhas alt    blue3 escuro
 *   bg-surface   #364149   painéis / cards
 *   bg-elevated  #586573   inputs / hover         blue2
 *   bg-active    #4a5663   item selecionado       blue2 escuro
 *   bg-popup     #2a333b   dropdown / popup
 *
 *   accent       #f8ad57   primário / caret       orange
 *   accent-dim   #d4903a   hover do acento
 *   accent-text  #fac660   texto em acento        orange3
 *   cyan         #5fb3b3   foco / headers         blue5
 *   blue         #5b98d6   accent azul
 *   green        #99c694   positivo               green
 *   danger       #ec5f66   erro / parar           red
 *   danger-dim   #c94d54   hover danger
 *
 *   text-primary   #d7dde8   white3
 *   text-secondary #a6acb9   blue6
 *   text-muted     #637281   blue4
 *   border         #4a5360
 *   border-focus   #5fb3b3   = cyan
 *
 *   font-mono: "JetBrains Mono", "Cascadia Code", "Consolas", monospace
 *   font-size: 15px / 13px
 */

/* ── Reset global ─────────────────────────────────────────────────────────── */

* {
    font-family: "Consolas", "Fira Code", "JetBrains Mono", monospace;
    font-size: 15px;
    color: #d7dde8;
    outline: none;
}

QMainWindow {
    background-color: #2f3840;
}

QWidget {
    background-color: transparent;
}

QDialog {
    background-color: #364149;
}

QCalendarWidget {
    background-color: #364149;
    color: #d7dde8;
}

QCalendarWidget QToolButton {
    background-color: #242b31;
    color: #d7dde8;
    border: none;
    padding: 5px;
}

QCalendarWidget QToolButton:hover {
    background-color: #586573;
}

QCalendarWidget QSpinBox {
    background-color: #242b31;
    color: #d7dde8;
    border: 1px solid #4a5360;
}

QCalendarWidget QAbstractItemView {
    background-color: #2a333b;
    color: #d7dde8;
    selection-background-color: #5fb3b3;
    selection-color: #242b31;
}


/* ── Painéis / frames ─────────────────────────────────────────────────────── */

QFrame#panelMain {
    background-color: #364149;
    border: 1px solid #4a5360;
    border-radius: 8px;
    margin: 12px;
}

QFrame#panelStatus {
    background-color: #242b31;
    border-top: 1px solid #4a5360;
}

/* ── Labels ───────────────────────────────────────────────────────────────── */

QLabel {
    color: #d7dde8;
    background: transparent;
}

QLabel#labelFieldCaption {
    color: #5fb3b3;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

QLabel#labelStatus {
    color: #a6acb9;
    font-size: 13px;
}

QLabel#labelStatusActive {
    color: #99c694;
    font-size: 13px;
    font-weight: 600;
}

QLabel#labelTotalHoje {
    color: #a6acb9;
    font-size: 13px;
}

QLabel#labelAppTitle {
    color: #d7dde8;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.3px;
}

QLabel#labelVersion {
    color: #637281;
    font-size: 11px;
}

/* ── Inputs de texto ──────────────────────────────────────────────────────── */

QLineEdit {
    background-color: #242b31;
    border: 1px solid #4a5360;
    border-radius: 4px;
    padding: 6px 8px;
    color: #d7dde8;
    selection-background-color: #586573;
    selection-color: #5fb3b3;
}

QLineEdit:focus {
    border-color: #5fb3b3;
    background-color: #2a333b;
}

QLineEdit:disabled {
    color: #637281;
    background-color: #2a3038;
    border-color: #3a4350;
}

QLineEdit#lineEditHora {
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 15px;
    letter-spacing: 1px;
    text-align: center;
    min-width: 90px;
    max-width: 110px;
}

/* ── TextEdit (nota) ──────────────────────────────────────────────────────── */

QTextEdit#textEditNota {
    background-color: #242b31;
    border: 1px solid #4a5360;
    border-radius: 4px;
    padding: 6px 8px;
    color: #d7dde8;
    selection-background-color: #586573;
}

QTextEdit#textEditNota:focus {
    border-color: #5fb3b3;
}

/* ── ComboBox / filtro ────────────────────────────────────────────────────── */

QComboBox {
    background-color: #242b31;
    border: 1px solid #4a5360;
    border-radius: 4px;
    padding: 3px 6px;
    color: #d7dde8;
    min-height: 20px;
}

QComboBox:hover {
    background-color: #586573;
}

QComboBox:focus,
QComboBox:on {
    border-color: #5fb3b3;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #a6acb9;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #2a333b;
    border: 1px solid #4a5360;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #586573;
    selection-color: #5fb3b3;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 7px 12px;
    border-radius: 4px;
    min-height: 22px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #4a5663;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #586573;
    color: #5fb3b3;
}

/* ── Botões ───────────────────────────────────────────────────────────────── */

QPushButton {
    border-radius: 5px;
    padding: 7px 14px;
    font-weight: bold;
    font-size: 15px;
    border: 1px solid #4a5360;
    background-color: #586573;
    color: #d7dde8;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #6c7987;
}

/* Primário: Iniciar/Registrar — laranja Mariana */
QPushButton#btnIniciar {
    background-color: #f8ad57;
    color: #242b31;
    border: none;
    font-weight: bold;
}

QPushButton#btnIniciar:hover {
    background-color: #fac660;
    color: #242b31;
}

QPushButton#btnIniciar:pressed {
    background-color: #d4903a;
}

QPushButton#btnIniciar:disabled {
    background-color: #4a3a20;
    color: #637281;
    border: none;
}

/* Perigo: Parar */
QPushButton#btnParar {
    background-color: transparent;
    color: #ec5f66;
    border: 1px solid #ec5f66;
    border-radius: 4px;
}

QPushButton#btnParar:hover {
    background-color: rgba(236, 95, 102, 0.15);
}

QPushButton#btnParar:pressed {
    background-color: rgba(236, 95, 102, 0.25);
}

QPushButton#btnParar:disabled {
    color: #637281;
    border-color: #637281;
}

/* Secundário: neutro */
QPushButton#btnSecundario {
    background-color: #586573;
    color: #d7dde8;
    border: 1px solid #4a5360;
}

QPushButton#btnSecundario:hover {
    background-color: #6c7987;
    color: #d7dde8;
}

QPushButton#btnSecundario:pressed {
    background-color: #4a5663;
}

/* Confirmar (diálogos de automação) */
QPushButton#btnConfirmar {
    background-color: #f8ad57;
    color: #242b31;
    border: none;
    font-weight: bold;
    padding: 8px 20px;
}

QPushButton#btnConfirmar:hover {
    background-color: #fac660;
    color: #242b31;
}

/* Ícone pequeno (histórico, config) */
QPushButton#btnIcone {
    background-color: transparent;
    color: #a6acb9;
    border: none;
    padding: 6px 8px;
    font-size: 16px;
    border-radius: 5px;
}

QPushButton#btnIcone:hover {
    background-color: #586573;
    color: #d7dde8;
}

/* Favorito — chip */
QPushButton#btnFavorito {
    background-color: #364149;
    color: #a6acb9;
    border: 1px solid #4a5360;
    border-radius: 14px;
    padding: 5px 12px;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
}

QPushButton#btnFavorito:hover {
    background-color: #4a5663;
    color: #d7dde8;
    border-color: #5fb3b3;
}

/* Botões de ação do histórico */
QPushButton#btnAcao,
QPushButton#btnDel {
    background-color: #364149;
    border: 1px solid #4a5360;
    border-radius: 4px;
    color: #d7dde8;
    padding: 0px;
}

QPushButton#btnAcao:hover,
QPushButton#btnDel:hover {
    background-color: #4a5663;
    border-color: #5fb3b3;
}

QPushButton#btnAcao:pressed,
QPushButton#btnDel:pressed {
    background-color: #2a333b;
}

QPushButton#btnAcao:disabled,
QPushButton#btnDel:disabled {
    background-color: #2a333b;
    border-color: #3a4350;
    color: #637281;
}

QPushButton#btnDel:hover {
    background-color: rgba(236, 95, 102, 0.15);
    border-color: #ec5f66;
}

/* ── Menu bar ─────────────────────────────────────────────────────────────── */

QMenuBar {
    background-color: #242b31;
    border-bottom: 1px solid #4a5360;
    padding: 2px 4px;
    spacing: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 5px;
    color: #a6acb9;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #586573;
    color: #d7dde8;
}

QMenu {
    background-color: #2a333b;
    border: 1px solid #4a5360;
    border-radius: 6px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 5px;
    color: #d7dde8;
}

QMenu::item:selected {
    background-color: #586573;
    color: #5fb3b3;
}

QMenu::item:disabled {
    color: #637281;
}

QMenu::separator {
    height: 1px;
    background-color: #4a5360;
    margin: 4px 8px;
}

/* ── ScrollBar ────────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #4a5360;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #586573;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #4a5360;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #586573;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Tooltip ──────────────────────────────────────────────────────────────── */

QToolTip {
    background-color: #2a333b;
    border: 1px solid #4a5360;
    border-radius: 5px;
    color: #d7dde8;
    padding: 5px 8px;
    font-size: 13px;
}

/* ── Splitter ─────────────────────────────────────────────────────────────── */

QSplitter::handle {
    background: #4a5360;
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* ── QCheckBox ────────────────────────────────────────────────────────────── */

QCheckBox {
    color: #a6acb9;
    font-size: 13px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #4a5360;
    border-radius: 3px;
    background: #242b31;
}

QCheckBox::indicator:hover {
    border-color: #5fb3b3;
}

QCheckBox::indicator:checked {
    background: #5fb3b3;
    border-color: #5fb3b3;
}

/* ── QGroupBox ────────────────────────────────────────────────────────────── */

QGroupBox {
    border: 1px solid #4a5360;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 6px;
    font-size: 13px;
    color: #a6acb9;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* ── MessageBox ───────────────────────────────────────────────────────────── */

QMessageBox {
    background-color: #2f3840;
}

QMessageBox QLabel {
    color: #d7dde8;
    font-size: 15px;
}

QMessageBox QPushButton {
    background-color: #586573;
    color: #d7dde8;
    border: 1px solid #4a5360;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 70px;
}

QMessageBox QPushButton:hover {
    background-color: #6c7987;
}

/* ── Indicador de estado (propriedade dinâmica) ───────────────────────────── */

QLabel#ledStatus[status="idle"] {
    color: #637281;
}

QLabel#ledStatus[status="active"] {
    color: #99c694;
}

/* ── Header / footer ──────────────────────────────────────────────────────── */

QFrame#appHeader {
    background-color: #242b31;
    border-bottom: 1px solid #4a5360;
}

QLabel#appHeaderIcon {
    font-size: 11px;
    font-weight: 700;
    color: #f8ad57;
    background: #4a3a20;
    border-radius: 4px;
    padding: 2px 5px;
}

QFrame#dialogHeader {
    background-color: #242b31;
    border-bottom: 1px solid #4a5360;
}

QFrame#dialogFooter {
    background-color: #242b31;
    border-top: 1px solid #4a5360;
}

/* ── FilterableComboBox ───────────────────────────────────────────────────── */

QWidget#fcbOuter {
    background: #242b31;
    border: 1px solid #4a5360;
    border-radius: 4px;
}

QWidget#fcbOuter[focused="true"] {
    border-color: #5fb3b3;
}

QWidget#fcbOuter:disabled {
    background: #2a333b;
    border-color: #3a4350;
}

QLineEdit#fcbEdit {
    background: transparent;
    border: none;
    color: #d7dde8;
    font-size: 15px;
    padding: 7px 0 7px 10px;
    selection-background-color: #586573;
}

QLineEdit#fcbEdit:disabled {
    color: #637281;
}

QPushButton#fcbArrow {
    background: transparent;
    border: none;
    color: #a6acb9;
    font-size: 10px;
    padding: 0 8px;
    min-width: 22px;
    max-width: 22px;
}

QPushButton#fcbArrow:hover {
    color: #d7dde8;
}

QPushButton#fcbClear {
    background: transparent;
    border: none;
    color: #a6acb9;
    font-size: 13px;
    padding: 0 4px;
    min-width: 20px;
    max-width: 20px;
}

QPushButton#fcbClear:hover {
    color: #ec5f66;
}

/* ── Dropdown popup ───────────────────────────────────────────────────────── */

QFrame#dropdown {
    background: #2a333b;
    border: 1px solid #5fb3b3;
    border-radius: 4px;
}

QPushButton#dropItem {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #d7dde8;
    font-size: 15px;
    padding: 7px 12px;
    text-align: left;
}

QPushButton#dropItem:hover {
    background: #586573;
    color: #5fb3b3;
}

QLabel#dropVazio {
    color: #637281;
    font-size: 13px;
    padding: 8px 12px;
}

/* ── Favoritos popup ──────────────────────────────────────────────────────── */

QFrame#favPopup {
    background: #2a333b;
    border: 1px solid #5fb3b3;
    border-radius: 6px;
}

QPushButton#favItem {
    background: transparent;
    border: none;
    border-radius: 4px;
    text-align: left;
    padding: 8px 12px;
    color: #d7dde8;
    font-size: 13px;
}

QPushButton#favItem:hover {
    background: #586573;
    color: #5fb3b3;
}

/* ── Tabela ───────────────────────────────────────────────────────────────── */

QTableWidget {
    background-color: #242b31;
    alternate-background-color: #2f3840;
    border: 1px solid #4a5360;
    gridline-color: #4a5360;
    color: #d7dde8;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #586573;
    color: #5fb3b3;
    font-size: 13px;
    font-weight: bold;
    border: none;
    border-right: 1px solid #4a5360;
    border-bottom: 1px solid #4a5360;
    padding: 7px 8px;
}

QTableWidget::item {
    padding: 2px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #586573;
    color: #5fb3b3;
}

/* ── Alerta inline ────────────────────────────────────────────────────────── */

QLabel#lblAvisoAlerta {
    background: #4a3a20;
    color: #fac660;
    padding: 8px;
    border-radius: 4px;
    border: 1px solid #f8ad57;
}
